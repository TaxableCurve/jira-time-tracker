{
  "name": "jira-time-tracker",
  "version": "1.6.5",
  "description": "Local Jira time tracking app with calendar and reports",
  "author": "TaxableCurve <diego.fdo.perez7@hotmail.com>",
  "license": "MIT",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "release:patch": "pnpm version patch && git push && git push --tags",
    "release:minor": "pnpm version minor && git push && git push --tags",
    "release:major": "pnpm version major && git push && git push --tags",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently \"next dev\" \"wait-on http://localhost:3000/api/health && NODE_ENV=development electron .\"",
    "electron:build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && tsc -p tsconfig.electron.json && electron-builder",
    "electron:dist": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && tsc -p tsconfig.electron.json && electron-builder --publish always"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@tanstack/react-query": "^5.100.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-holidays": "^3.28.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "^19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.1",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^6",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.taxablecurve.jira-time-tracker",
    "productName": "Jira Time Tracker",
    "icon": "resources/icons",
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "TaxableCurve",
      "repo": "jira-time-tracker"
    },
    "files": [
      ".next/standalone/**",
      ".next/static/**",
      "public/**",
      "electron/dist/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/dist/main.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "deb": {}
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron-winstaller",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  }
}
